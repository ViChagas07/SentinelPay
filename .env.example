# Copie para .env e preencha localmente. NUNCA commite o .env.
# Todos os valores abaixo sao PLACEHOLDERS. Nao coloque segredos reais neste arquivo.

APP_ENV=local
APP_NAME=PaySentinelIQ
LOG_LEVEL=INFO
FRONTEND_URL=http://localhost:3000
COOKIE_DOMAIN=
CORS_ALLOWED_ORIGINS=http://localhost:3000
ALLOWED_HOSTS=localhost,127.0.0.1,test,testserver,api

# Banco (asyncpg)
POSTGRES_USER=sentinel
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=paysentineliq
POSTGRES_PORT=55432
DATABASE_URL=postgresql+asyncpg://sentinel:CHANGE_ME@127.0.0.1:55432/paysentineliq

# Portas do host para o Compose local
API_PORT=8000
REDIS_PORT=6379
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# Redis / RabbitMQ / Celery
REDIS_URL=redis://127.0.0.1:6379/0
RABBITMQ_DEFAULT_USER=sentinel
RABBITMQ_DEFAULT_PASS=CHANGE_ME
CELERY_BROKER_URL=amqp://sentinel:CHANGE_ME@127.0.0.1:5672//
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/1
CELERY_TASK_ALWAYS_EAGER=0
CELERY_TASK_SOFT_TIME_LIMIT_SECONDS=900
CELERY_TASK_TIME_LIMIT_SECONDS=960

# Analises assincronas (P13)
ANALYSIS_TASK_MAX_RETRIES=3
ANALYSIS_MAX_CONCURRENT_PER_USER=2
ANALYSIS_LEASE_SECONDS=900
ANALYSIS_STALE_SWEEP_SECONDS=300
PAYABLES_REMINDER_INTERVAL_SECONDS=120
PAYABLES_OVERDUE_INTERVAL_SECONDS=600
PAYABLES_REMINDER_LOOKBACK_DAYS=7
FRAUD_MODEL_DIR=models/artifacts
LLM_INTERPRETER=structured

# Auth
JWT_SECRET=CHANGE_ME_USE_AT_LEAST_32_RANDOM_BYTES
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
GOOGLE_CLIENT_ID=CHANGE_ME
GOOGLE_CLIENT_SECRET=CHANGE_ME
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback
OIDC_STATE_TTL_SECONDS=600
# TTL do ticket de uso unico que conclui o login Google no front.
AUTH_LOGIN_TICKET_TTL_SECONDS=60

# Rate limit (token bucket)
RATE_LIMIT_CAPACITY=60
RATE_LIMIT_REFILL_PER_SEC=1
# Fora de APP_ENV=local, vazio deriva de JWT_SECRET via HKDF.
SECURITY_HASH_SECRET=CHANGE_ME

# Cache stale-while-revalidate
SWR_SOFT_TTL_SECONDS=30
SWR_HARD_TTL_SECONDS=300
SWR_JITTER_RATIO=0.2
SWR_LOCK_TTL_SECONDS=10
SWR_WAIT_TIMEOUT_SECONDS=2

# Limites
MAX_REQUEST_BODY_BYTES=1048576
REQUEST_TIMEOUT_SECONDS=30

# Forca bruta (auth na P04)
BRUTEFORCE_MAX_ATTEMPTS=5
BRUTEFORCE_WINDOW_SECONDS=900
BRUTEFORCE_BASE_BLOCK_SECONDS=30
BRUTEFORCE_MAX_BLOCK_SECONDS=3600

# Storage S3 (local: MinIO; producao: AWS S3)
S3_ENDPOINT_URL=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=paysentineliq-documents
S3_ACCESS_KEY_ID=CHANGE_ME
S3_SECRET_ACCESS_KEY=CHANGE_ME
MINIO_KMS_SECRET_KEY=local-dev-kms:QUFBQUFBQUFBQUFBQUFBQUFBQUFBQUFBQUFBQUFBQUE=
UPLOAD_MAX_MB=25
PDF_MAX_PAGES=50
S3_PRESIGNED_URL_TTL_SECONDS=300

# OCR / visao (CPU)
OCR_LANGS=pt,es,en
OCR_MAX_PAGES=20
OCR_RENDER_DPI=200
OCR_TIMEOUT_SECONDS=120
OCR_MAX_IMAGE_PIXELS=25000000
OCR_NATIVE_MIN_CHARS=40

# LLM (OpenAI compatible). Local: LM Studio. Producao: provedor compativel.
LLM_BASE_URL=http://localhost:1234/v1
LLM_API_KEY=lm-studio
LLM_MODEL=CHANGE_ME_MODEL_ID
LLM_JUDGE_MODEL=CHANGE_ME_MODEL_ID
LLM_TEMPERATURE=0.1
LLM_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=2
LLM_MAX_OUTPUT_TOKENS=800
LLM_MAX_SCORE_ADJUSTMENT=5
LLM_LANGUAGE=pt
AI_NODE_TIMEOUT_SECONDS=60

# Guardrails P12 (classificador opcional; artefato fora do git)
GUARDRAIL_CLASSIFIER_ENABLED=0
GUARDRAIL_CLASSIFIER_THRESHOLD=0.5
GUARDRAIL_CLASSIFIER_MODEL_DIR=models/artifacts
GUARDRAIL_JUDGE_ENABLED=0
GUARDRAIL_MAX_TEXT_CHARS=20000
GUARDRAIL_LLM_EXCERPT_CHARS=6000
GUARDRAIL_ALLOWED_OUTPUT_URLS=

# Telemetria/tracing de terceiros desligados
CREWAI_DISABLE_TELEMETRY=true
CREWAI_DISABLE_TRACKING=true
CREWAI_TRACING_ENABLED=false
LANGCHAIN_TRACING_V2=false
LANGSMITH_TRACING=false
ANONYMIZED_TELEMETRY=false

# Hosts fixos de infraestrutura permitidos pela guarda SSRF
SSRF_ALLOWED_HOSTS=localhost,127.0.0.1

# Embeddings (OpenAI compatible) e vetor
EMBEDDING_BASE_URL=http://localhost:1234/v1
EMBEDDING_MODEL=CHANGE_ME_EMBEDDING_MODEL_ID
# 8 e a dimensao do embedder falso de desenvolvimento/teste; use a dimensao do modelo real.
EMBEDDING_DIM=8
EMBEDDING_API_KEY=
EMBEDDING_TIMEOUT_SECONDS=30
EMBEDDING_BATCH_SIZE=32
EMBEDDING_MAX_RETRIES=3
EMBEDDING_RETRY_BACKOFF_SECONDS=1
VECTOR_STORE=pgvector
PINECONE_API_KEY=
PINECONE_INDEX=
PINECONE_NAMESPACE=knowledge
RAG_CHUNK_SIZE=1200
RAG_CHUNK_OVERLAP=150
RAG_FAKE_EMBEDDER=1
# Retrieval local em dois estagios (BGE-M3 + BGE reranker v2 m3)
HYBRID_RETRIEVAL_ENABLED=0
HYBRID_FUSION=rrf
HYBRID_RRF_K=60
HYBRID_DENSE_WEIGHT=0.6
HYBRID_SPARSE_WEIGHT=0.4
QUERY_EMBEDDING_CACHE_TTL_SECONDS=3600
RETRIEVAL_MODEL_DIR=models/retrieval
RETRIEVAL_TOP_K=25
RERANK_TOP_N=4
RERANK_ENABLED=1
EMBEDDER_BACKEND=onnx
RERANKER_BACKEND=onnx
RERANKER_REMOTE_URL=
RERANKER_REMOTE_API_KEY=
RERANKER_REMOTE_MODEL=BAAI/bge-reranker-v2-m3
RERANK_TIMEOUT_SECONDS=30
RERANK_MAX_LENGTH=512
BATCH_SIZE=16
TORCH_NUM_THREADS=0

# OCR
OCR_LANGS=pt,es,en
OCR_MAX_PAGES=10

# Notificacoes
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=no-reply@paysentineliq.local
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=0
SMTP_TIMEOUT_SECONDS=10
NOTIFICATIONS_DELIVERY_MAX_RETRIES=3
NOTIFICATIONS_DELIVERY_RETRY_BACKOFF_SECONDS=60
SMS_PROVIDER=console
WHATSAPP_PROVIDER=console

# Observabilidade
OTEL_SDK_DISABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
OTEL_SERVICE_NAME=paysentineliq-api
OTEL_SERVICE_VERSION=0.1.0
OTEL_TRACES_SAMPLER_RATIO=1.0
OTEL_EXPORTER_TIMEOUT_SECONDS=5
# Vazio fora de APP_ENV=local mantem /metrics bloqueado (401).
METRICS_TOKEN=CHANGE_ME
QUEUE_DEPTH_REFRESH_SECONDS=15

# Langfuse Cloud (opcional; desligado por padrao)
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=
LANGFUSE_BASE_URL=
LANGFUSE_SAMPLE_RATE=1.0
RABBITMQ_MANAGEMENT_URL=
GRAFANA_PORT=3001
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME
PROMETHEUS_PORT=9090
TEMPO_PORT=3200
OTEL_GRPC_PORT=4317
OTEL_HTTP_PORT=4318




# Autenticacao por e-mail e senha (P20)
# Ligada por padrao. O login por senha so exige e-mail verificado depois do
# cadastro, e o cadastro so e oferecido quando ha provedor de e-mail pronto.
# Sem provedor configurado, a aba de cadastro some e as rotas de e-mail
# respondem 503 auth_not_configured.
AUTH_PASSWORD_ENABLED=true
# disabled | development | smtp. development so e aceito com APP_ENV=local.
AUTH_EMAIL_PROVIDER=smtp

AUTH_EMAIL_DEVELOPMENT_DIR=var/auth-outbox
AUTH_EMAIL_MAX_ATTEMPTS=3
# Base fixa usada nos links de e-mail. Nunca derivada do cabecalho Host.
APP_BASE_URL=http://localhost:3000
AUTH_VERIFICATION_TOKEN_TTL_MINUTES=1440
AUTH_RESET_TOKEN_TTL_MINUTES=30
AUTH_MAX_TOKENS_PER_HOUR=3

# Politica de senha e Argon2id
PASSWORD_MIN_LENGTH=10
PASSWORD_MAX_LENGTH=128
PASSWORD_HIBP_ENABLED=false
ARGON2_TIME_COST=3
ARGON2_MEMORY_COST_KIB=65536
ARGON2_PARALLELISM=4
ARGON2_HASH_LEN=32
ARGON2_SALT_LEN=16

# Bloqueio progressivo por conta
ACCOUNT_LOCKOUT_MAX_ATTEMPTS=5
ACCOUNT_LOCKOUT_BASE_SECONDS=30
ACCOUNT_LOCKOUT_MAX_SECONDS=3600

# Rate limit Token Bucket por IP e por e-mail normalizado
AUTH_RATE_LIMIT_WINDOW_SECONDS=900
AUTH_RATE_LIMIT_SENSITIVE_WINDOW_SECONDS=3600
AUTH_RATE_LIMIT_LOGIN_IP=20
AUTH_RATE_LIMIT_LOGIN_IDENTIFIER=10
AUTH_RATE_LIMIT_REGISTER_IP=10
AUTH_RATE_LIMIT_REGISTER_IDENTIFIER=5
AUTH_RATE_LIMIT_FORGOT_IP=10
AUTH_RATE_LIMIT_FORGOT_IDENTIFIER=5
AUTH_RATE_LIMIT_RESEND_IP=10
AUTH_RATE_LIMIT_RESEND_IDENTIFIER=3

# Captcha opcional, desligado e sem provedor contratado
CAPTCHA_ENABLED=false

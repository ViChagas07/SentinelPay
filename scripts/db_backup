#!/usr/bin/env python3
from __future__ import annotations

import subprocess
import sys
from datetime import UTC, datetime
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
BACKUP_DIR = ROOT / "backups"
COMPOSE = ["docker", "compose", "--env-file", ".env.example"]
PG_DUMP = 'pg_dump -U "$POSTGRES_USER" -d "$POSTGRES_DB" --no-owner --no-privileges'


def main() -> int:
    BACKUP_DIR.mkdir(parents=True, exist_ok=True)
    timestamp = datetime.now(UTC).strftime("%Y%m%dT%H%M%SZ")
    target = BACKUP_DIR / f"paysentineliq_{timestamp}.sql"

    result = subprocess.run(
        [*COMPOSE, "exec", "-T", "postgres", "sh", "-c", PG_DUMP],
        cwd=ROOT,
        capture_output=True,
        check=False,
    )
    if result.returncode != 0:
        sys.stderr.write(
            "backup failed: pg_dump returned non-zero; is postgres running?\n"
        )
        return 1
    if not result.stdout:
        sys.stderr.write("backup failed: empty dump\n")
        return 1

    target.write_bytes(result.stdout)
    size = target.stat().st_size
    if size == 0:
        target.unlink(missing_ok=True)
        sys.stderr.write("backup failed: empty file\n")
        return 1

    print(f"backup written: {target.relative_to(ROOT)} ({size} bytes)")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())

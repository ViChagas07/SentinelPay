# URL base da API, sem o prefixo /api/v1.
# Em desenvolvimento, a API FastAPI roda em http://localhost:8000.
NEXT_PUBLIC_API_URL=http://localhost:8000

# URL que o servidor Next usa para falar com a API (BFF).
# Em produção, deve apontar para o serviço interno do FastAPI.
API_INTERNAL_URL=http://localhost:8000

# Container usado pelos testes e2e para criar uma sessão real de teste.
# Deixe vazio para pular os testes que dependem do backend.
E2E_API_CONTAINER=paysentineliq-api-1

# URL do cartão de ajuda na sidebar e do link de suporte do rodapé.
# Deixe vazio para usar a página interna /suporte.
NEXT_PUBLIC_SUPPORT_URL=

# Canal de privacidade e LGPD. Se a URL estiver vazia, o e-mail é usado.
# Sem nenhum dos dois, a conta aponta para a página interna /suporte.
NEXT_PUBLIC_PRIVACY_CONTACT_URL=
NEXT_PUBLIC_PRIVACY_CONTACT_EMAIL=

# Dados institucionais exibidos nas páginas de Termos de uso e Política de privacidade.
# Campo vazio é omitido da interface. Nunca invente valores.
NEXT_PUBLIC_LEGAL_CONTROLLER_NAME=
NEXT_PUBLIC_LEGAL_CONTROLLER_TAX_ID=
NEXT_PUBLIC_LEGAL_ADDRESS=
NEXT_PUBLIC_LEGAL_CONTACT_EMAIL=
NEXT_PUBLIC_LEGAL_DPO_NAME=
NEXT_PUBLIC_LEGAL_DPO_EMAIL=

# URL pública do front-end, usada como base absoluta dos metadados Open Graph.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Limite de upload em MB. Deve espelhar UPLOAD_MAX_MB do backend.
NEXT_PUBLIC_UPLOAD_MAX_MB=25

# Observabilidade opcional. Sem DSN, nenhum SDK de erro é carregado.
# O DSN do Sentry é público por definição. Nunca use token de API aqui.
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=
NEXT_PUBLIC_SENTRY_RELEASE=
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0
